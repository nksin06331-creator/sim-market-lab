{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sim.marketlab/schemas/report_bundle_v1_2.json",
  "title": "SiM MARKET LAB Report Bundle v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "capital_structure", "claims", "sources", "guide", "scenario", "catalyst_report", "validation_summary"],
  "properties": {
    "meta": {"$ref": "#/$defs/meta"},
    "capital_structure": {"$ref": "#/$defs/capitalStructure"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "guide": {"$ref": "#/$defs/guide"},
    "scenario": {"$ref": "#/$defs/scenarioReport"},
    "catalyst_report": {"$ref": "#/$defs/catalystReport"},
    "validation_summary": {"$ref": "#/$defs/validationSummary"}
  },
  "$defs": {
    "evidenceClass": {"enum": ["CONFIRMED", "COMPANY_GUIDANCE", "CONSENSUS", "MODEL_ESTIMATE", "UNKNOWN"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "numericRange": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "idArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_version", "schema_version", "company_name", "ticker", "exchange", "currency", "fiscal_year_end", "valuation_date", "source_cutoff", "generated_at", "price", "price_as_of", "benchmark"],
      "properties": {
        "framework_version": {"const": "6.2"},
        "schema_version": {"const": "1.2"},
        "company_name": {"type": "string", "minLength": 1},
        "ticker": {"type": "string", "minLength": 1},
        "exchange": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "fiscal_year_end": {"type": ["string", "null"]},
        "valuation_date": {"type": "string", "format": "date"},
        "source_cutoff": {"type": "string"},
        "generated_at": {"type": "string"},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "price_as_of": {"type": "string"},
        "benchmark": {"type": ["string", "null"]}
      }
    },
    "capitalStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basic_shares", "diluted_shares", "market_cap", "cash", "liquid_securities", "restricted_cash", "minimum_operating_cash", "debt", "preferred_stock", "minority_interest", "other_non_equity_claims", "source_ids"],
      "properties": {
        "basic_shares": {"type": "number", "exclusiveMinimum": 0},
        "diluted_shares": {"type": "number", "exclusiveMinimum": 0},
        "market_cap": {"type": "number", "exclusiveMinimum": 0},
        "cash": {"type": "number"},
        "liquid_securities": {"type": "number"},
        "restricted_cash": {"type": "number", "minimum": 0},
        "minimum_operating_cash": {"type": "number", "minimum": 0},
        "debt": {"type": "number", "minimum": 0},
        "preferred_stock": {"type": "number", "minimum": 0},
        "minority_interest": {"type": "number", "minimum": 0},
        "other_non_equity_claims": {"type": "number", "minimum": 0},
        "ttm_operating_cash_flow": {"type": ["number", "null"]},
        "ttm_capex": {"type": ["number", "null"]},
        "burn_one_off_adjustments": {"type": ["number", "null"]},
        "runway_months": {"type": ["number", "null"], "minimum": 0},
        "source_ids": {"$ref": "#/$defs/idArray"},
        "dilution_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "classification", "as_of", "source_ids", "calculation_id", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "classification": {"$ref": "#/$defs/evidenceClass"},
        "as_of": {"type": ["string", "null"]},
        "source_ids": {"$ref": "#/$defs/idArray"},
        "calculation_id": {"type": ["string", "null"]},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "published_at", "accessed_at", "source_type", "is_primary", "supports_claim_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "published_at": {"type": ["string", "null"]},
        "accessed_at": {"type": "string"},
        "source_type": {"enum": ["IR", "FILING", "REGULATOR", "GOVERNMENT", "EXCHANGE", "PARTNER", "MARKET_DATA", "INDUSTRY_DATA", "NEWS", "ANALYST", "OTHER"]},
        "is_primary": {"type": "boolean"},
        "supports_claim_ids": {"$ref": "#/$defs/idArray"}
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagline", "section_claim_ids", "source_ids"],
      "properties": {
        "tagline": {"type": "string", "minLength": 1},
        "section_claim_ids": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/idArray"},
          "required": ["sec1", "sec2", "sec3", "sec4", "sec5", "sec6", "sec7"]
        },
        "source_ids": {"$ref": "#/$defs/idArray"}
      }
    },
    "scenarioCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "probability", "enterprise_value", "equity_value", "diluted_shares", "price", "conditions", "assumption_claim_ids"],
      "properties": {
        "label": {"enum": ["BEAR", "BASE", "BULL"]},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "enterprise_value": {"type": ["number", "null"]},
        "equity_value": {"type": "number"},
        "diluted_shares": {"type": "number", "exclusiveMinimum": 0},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "assumption_claim_ids": {"$ref": "#/$defs/idArray"}
      }
    },
    "scenarioReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon_date", "primary_method", "method_explanation", "cases", "computed", "risk_class", "risk_reasons", "major_catalyst_id", "sensitivity", "distribution_method"],
      "properties": {
        "horizon_date": {"type": "string", "format": "date"},
        "primary_method": {"enum": ["DCF", "EV_SALES", "EV_EBITDA", "PE", "RNPV", "SOTP", "PB", "RESIDUAL_INCOME", "OTHER"]},
        "method_explanation": {"type": "string", "minLength": 1},
        "cases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/scenarioCase"}},
        "computed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_price", "expected_delta_pct", "raw_band_position_pct", "display_band_position_pct", "endpoint_rr", "market_score", "own_score", "supplemental_score"],
          "properties": {
            "expected_price": {"type": "number"},
            "expected_delta_pct": {"type": "number"},
            "raw_band_position_pct": {"type": "number"},
            "display_band_position_pct": {"type": "number", "minimum": 0, "maximum": 100},
            "endpoint_rr": {"type": ["number", "null"]},
            "market_score": {"type": "integer", "minimum": 0, "maximum": 100},
            "own_score": {"type": "integer", "minimum": 0, "maximum": 100},
            "supplemental_score": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "risk_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "major_catalyst_id": {"type": ["string", "null"]},
        "sensitivity": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["variable", "low", "base", "high", "result_prices"], "properties": {"variable": {"type": "string"}, "low": {"type": "number"}, "base": {"type": "number"}, "high": {"type": "number"}, "result_prices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}}},
        "distribution_method": {"enum": ["THREE_POINT", "MONTE_CARLO"]},
        "monte_carlo": {"type": ["object", "null"]}
      }
    },
    "dateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_text", "start_date", "end_date", "precision", "basis", "confidence", "timezone", "source_ids"],
      "properties": {
        "display_text": {"type": "string"},
        "start_date": {"type": ["string", "null"]},
        "end_date": {"type": ["string", "null"]},
        "precision": {"enum": ["EXACT", "WEEK", "MONTH", "QUARTER", "HALF", "YEAR", "WINDOW", "TBD"]},
        "basis": {"$ref": "#/$defs/evidenceClass"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "timezone": {"type": ["string", "null"]},
        "source_ids": {"$ref": "#/$defs/idArray"}
      }
    },
    "quantificationAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "reason"],
      "properties": {
        "method": {"enum": ["ENTERPRISE_VALUE_DELTA", "CONDITIONAL_SCENARIO", "CONSENSUS_REVISION", "SAME_COMPANY_EVENT_STUDY", "PEER_EVENT_STUDY"]},
        "status": {"enum": ["USED", "REJECTED", "NOT_APPLICABLE"]},
        "reason": {"type": "string", "minLength": 10}
      }
    },
    "nonQuantifiedExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "missing_information", "next_checks", "recalculation_method"],
      "properties": {
        "reason": {"type": "string", "minLength": 20},
        "missing_information": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "next_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "recalculation_method": {"type": "string", "minLength": 15}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "conditions", "direction", "quantifiable", "price_range", "price_change_pct_range", "probability", "method_note", "quantification_attempts", "non_quantified_explanation"],
      "properties": {
        "label": {"enum": ["SUCCESS", "INLINE", "FAILURE"]},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "direction": {"enum": ["UP", "FLAT", "DOWN", "MIXED", "UNKNOWN"]},
        "quantifiable": {"type": "boolean"},
        "price_range": {"oneOf": [{"$ref": "#/$defs/numericRange"}, {"type": "null"}]},
        "price_change_pct_range": {"oneOf": [{"$ref": "#/$defs/numericRange"}, {"type": "null"}]},
        "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "method_note": {"type": "string"},
        "quantification_attempts": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/quantificationAttempt"}},
        "non_quantified_explanation": {"oneOf": [{"$ref": "#/$defs/nonQuantifiedExplanation"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"quantifiable": {"const": false}}}, "then": {"properties": {"price_range": {"type": "null"}, "price_change_pct_range": {"type": "null"}, "method_note": {"type": "string", "minLength": 20}, "non_quantified_explanation": {"$ref": "#/$defs/nonQuantifiedExplanation"}}}},
        {"if": {"properties": {"quantifiable": {"const": true}}}, "then": {"properties": {"price_range": {"$ref": "#/$defs/numericRange"}, "price_change_pct_range": {"$ref": "#/$defs/numericRange"}, "non_quantified_explanation": {"type": "null"}}}}
      ]
    },
    "pricedIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantifiable", "method", "percent_range", "raw_implied_pct", "event_excluded_equity_value", "full_success_incremental_equity_value", "confidence", "evidence_for", "evidence_against", "caveats", "non_quantified_explanation"],
      "properties": {
        "quantifiable": {"type": "boolean"},
        "method": {"enum": ["EQUITY_VALUE", "BINARY_REVERSE", "QUALITATIVE", "NOT_APPLICABLE"]},
        "percent_range": {"oneOf": [{"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "number", "minimum": 0, "maximum": 100}], "items": false, "minItems": 2, "maxItems": 2}, {"type": "null"}]},
        "raw_implied_pct": {"type": ["number", "null"]},
        "event_excluded_equity_value": {"type": ["number", "null"]},
        "full_success_incremental_equity_value": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_for": {"type": "array", "items": {"type": "string"}},
        "evidence_against": {"type": "array", "items": {"type": "string"}},
        "caveats": {"type": "array", "items": {"type": "string"}},
        "non_quantified_explanation": {"oneOf": [{"$ref": "#/$defs/nonQuantifiedExplanation"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"quantifiable": {"const": false}}}, "then": {"properties": {"caveats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 20}}, "non_quantified_explanation": {"$ref": "#/$defs/nonQuantifiedExplanation"}}}},
        {"if": {"properties": {"quantifiable": {"const": true}}}, "then": {"properties": {"non_quantified_explanation": {"type": "null"}}}}
      ]
    },
    "catalyst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "status", "importance", "date", "plain_language", "mechanism", "outcomes", "priced_in", "dependencies", "dependency_group_id", "leading_indicators", "sell_the_news_risk", "financing_risk", "update_triggers", "source_ids", "claim_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "category": {"enum": ["EARNINGS", "PRODUCT", "CAPACITY", "R_AND_D", "REGULATORY", "CONTRACT", "PARTNERSHIP", "M_AND_A", "FINANCING", "POLICY", "LEGAL", "INDUSTRY", "OTHER"]},
        "status": {"enum": ["SCHEDULED", "WINDOWED", "ONGOING", "CONTINGENT", "TBD", "UNCONFIRMED"]},
        "importance": {"type": "integer", "minimum": 1, "maximum": 5},
        "date": {"$ref": "#/$defs/dateWindow"},
        "plain_language": {"type": "string", "minLength": 1},
        "mechanism": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outcomes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/outcome"}},
        "priced_in": {"$ref": "#/$defs/pricedIn"},
        "dependencies": {"$ref": "#/$defs/idArray"},
        "dependency_group_id": {"type": ["string", "null"]},
        "leading_indicators": {"type": "array", "items": {"type": "string"}},
        "sell_the_news_risk": {"type": "string"},
        "financing_risk": {"type": "string"},
        "update_triggers": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"$ref": "#/$defs/idArray"},
        "claim_ids": {"$ref": "#/$defs/idArray"}
      }
    },
    "dependencyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "relationship_type", "catalyst_ids", "aggregation_rule", "full_success_incremental_equity_value"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "relationship_type": {"enum": ["CHAIN", "SHARED_VALUE", "ALTERNATIVE", "ADDITIVE_INDEPENDENT"]},
        "catalyst_ids": {"$ref": "#/$defs/idArray"},
        "aggregation_rule": {"type": "string", "minLength": 1},
        "full_success_incremental_equity_value": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "overallPricedIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantifiable", "percent_range", "raw_implied_pct", "all_events_excluded_equity_value", "included_group_ids", "method_note", "confidence", "non_quantified_explanation"],
      "properties": {
        "quantifiable": {"type": "boolean"},
        "percent_range": {"oneOf": [{"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "number", "minimum": 0, "maximum": 100}], "items": false, "minItems": 2, "maxItems": 2}, {"type": "null"}]},
        "raw_implied_pct": {"type": ["number", "null"]},
        "all_events_excluded_equity_value": {"type": ["number", "null"]},
        "included_group_ids": {"$ref": "#/$defs/idArray"},
        "method_note": {"type": "string", "minLength": 20},
        "confidence": {"$ref": "#/$defs/confidence"},
        "non_quantified_explanation": {"oneOf": [{"$ref": "#/$defs/nonQuantifiedExplanation"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"quantifiable": {"const": false}}}, "then": {"properties": {"non_quantified_explanation": {"$ref": "#/$defs/nonQuantifiedExplanation"}}}},
        {"if": {"properties": {"quantifiable": {"const": true}}}, "then": {"properties": {"non_quantified_explanation": {"type": "null"}}}}
      ]
    },
    "catalystReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "next_catalyst_id", "catalysts", "dependency_groups", "overall_priced_in", "watch_items"],
      "properties": {
        "status": {"enum": ["CATALYST_RICH", "SELECTIVE", "EXPECTATIONS_HIGH", "BINARY", "NO_CONFIRMED_CATALYST"]},
        "next_catalyst_id": {"type": ["string", "null"]},
        "catalysts": {"type": "array", "items": {"$ref": "#/$defs/catalyst"}},
        "dependency_groups": {"type": "array", "items": {"$ref": "#/$defs/dependencyGroup"}},
        "overall_priced_in": {"$ref": "#/$defs/overallPricedIn"},
        "watch_items": {"type": "array", "items": {"type": "object", "required": ["item", "frequency", "update_trigger", "catalyst_ids"], "properties": {"item": {"type": "string"}, "frequency": {"type": "string"}, "update_trigger": {"type": "string"}, "catalyst_ids": {"$ref": "#/$defs/idArray"}}}}
      }
    },
    "validationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fail_count", "warn_count", "generated_at", "messages"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "PASS", "WARN", "FAIL"]},
        "fail_count": {"type": "integer", "minimum": 0},
        "warn_count": {"type": "integer", "minimum": 0},
        "generated_at": {"type": ["string", "null"]},
        "messages": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
